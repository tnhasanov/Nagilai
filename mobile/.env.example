# Only EXPO_PUBLIC_* variables reach the app bundle. Everything here is
# therefore public by definition — never put a secret in this file.
#
# The Supabase anon key is safe to ship: every table is protected by row
# level security, exactly as on the web.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
