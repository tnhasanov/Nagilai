# =====================================================================
# Nagilai — environment configuration (§33)
# =====================================================================
# Copy to `.env.local` and fill in. Never commit a real secret: only the
# NEXT_PUBLIC_* values below are safe in a browser bundle, and everything
# else stays server-side (§24, §37).
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# The public origin, used for share links, OAuth redirects and OG tags.
# On Vercel this can be left unset and is derived from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon key is safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service role key BYPASSES row level security. Server only. Never
# prefix it with NEXT_PUBLIC_, never log it, never send it to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used only by local tooling: `npm run db:types`
# regenerates src/types/database.ts by introspecting the schema, and
# scripts/verify-migrations.sh applies the migrations to a scratch database.
# Supabase → Connect → connection string. Not needed at runtime, and never
# set in production hosting.
# DATABASE_URL=postgresql://postgres:...@...:5432/postgres

# ---------------------------------------------------------------------
# OpenAI — server-side only (§5)
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: point at a proxy or an Azure-compatible endpoint.
# OPENAI_BASE_URL=

# Model ids normally live in the `app_settings.ai_models` row so they can
# be changed from the admin panel without a deploy. These override it.
# OPENAI_TEXT_MODEL=gpt-5
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_MODERATION_MODEL=omni-moderation-latest

# ---------------------------------------------------------------------
# Background worker (§27)
# ---------------------------------------------------------------------
# Shared secret for /api/jobs/worker. The endpoint refuses to run without
# it, because it spends money. Generate with: openssl rand -hex 32
CRON_SECRET=

# The worker accepts the secret as `Authorization: Bearer`, as an
# `X-Cron-Secret` header, or -- only when this is true -- as a `?token=`
# query parameter. Leave it off unless your scheduler genuinely cannot set
# a header: a secret in a URL is a secret in an access log.
# CRON_ALLOW_QUERY_SECRET=false

# Any scheduler can drive the queue: Vercel Cron, Supabase pg_cron, a
# GitHub Action, a container crontab. See docs/OPERATIONS.md.

# ---------------------------------------------------------------------
# Push notifications — optional
# ---------------------------------------------------------------------
# Without these the console provider runs: every notification is logged
# and recorded as skipped, so the whole path is testable and nothing
# pretends to have reached a phone. See docs/MOBILE.md.
#
# Switch on only once the Expo project exists and the store push
# credentials are uploaded (`eas credentials`).
# EXPO_PUSH_ENABLED=false
# Optional. Required only if the Expo project has enhanced security on.
# Expo dashboard -> Account settings -> Access tokens.
# EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# Native sign-in — optional
# ---------------------------------------------------------------------
# Apple and Google sign-in are configured in the Supabase dashboard
# (Authentication -> Providers), not here. The mobile app needs the client
# ids below to start a native flow; without them it hides those buttons
# and email sign-in still works. They are public identifiers, not secrets.
# See mobile/.env.example and docs/MOBILE.md for exactly which values to
# create and where.

# ---------------------------------------------------------------------
# Payments — Phase 2, optional (§16)
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------
# Email — optional (§25)
# ---------------------------------------------------------------------
# Without these, transactional email is a logged no-op and Supabase Auth
# still sends its own sign-in and reset messages.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Nagilai <hello@nagilai.com>"

# ---------------------------------------------------------------------
# Analytics — optional (§19)
# ---------------------------------------------------------------------
# Events are always written to the analytics_events table; these only
# add forwarding to a provider.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------
# Android — Trusted Web Activity (optional, NOT the main Android product)
# ---------------------------------------------------------------------
# The Play Store app is the native Expo app in `mobile/`, which owns the
# package name `com.nagilai.app`. This block only exists for an optional
# TWA wrapper of the website.
#
# Use a DIFFERENT package name here. Play binds a package name to an app
# record permanently on first upload, so publishing a TWA as
# `com.nagilai.app` would block the native app from ever using it.
#
# The fingerprints come from your upload keystore AND from Play's own app
# signing key, which only exists after the first upload. Comma-separated,
# 32 colon-separated hex pairs each. See docs/MOBILE.md.
# ANDROID_PACKAGE_NAME=com.nagilai.twa
# ANDROID_CERT_FINGERPRINTS=AA:BB:...:FF,11:22:...:99

# ---------------------------------------------------------------------
# Printing — Phase 3 (§15)
# ---------------------------------------------------------------------
# manual | gelato | lulu. Only `manual` is implemented: orders enter the
# admin fulfilment queue.
PRINT_PROVIDER=manual
# GELATO_API_KEY=
# LULU_CLIENT_KEY=
# LULU_CLIENT_SECRET=
